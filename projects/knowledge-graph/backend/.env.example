# Database
# 默认 SQLite（本地开发零配置）；生产建议 Postgres
DATABASE_URL=sqlite:///./knowledge_graph.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_graph

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# ──────────────────────────────────────────────
# AI / LLM 配置（至少配一个 *_API_KEY）
# ──────────────────────────────────────────────

# DeepSeek（默认模型，便宜可靠，强烈推荐配置）
DEEPSEEK_API_KEY=

# 默认 AI 模型（用于辩论之外的所有任务：discovery / 问题分类 / 总结 / spark 抽取等）
# 必须带 LiteLLM 前缀：anthropic/... openai/... deepseek/...
DEFAULT_AI_MODEL=deepseek/deepseek-chat

# 辩论引擎多 LLM family 池（可选；不配则三个角色都用默认模型）
# 配上后 G+F 抗 P0 雷同机制启用：同 discipline 的 Prof 和 Assoc 强制不同 LLM family
DEBATE_MODEL_PRO=
DEBATE_MODEL_CON=
DEBATE_MODEL_MODERATOR=

# 备用 LLM provider（可选）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# Optional services
# ──────────────────────────────────────────────

# Zep Cloud — Agent 长期记忆 + Graph RAG（可选；缺失则 /api/zep 路由禁用，不影响主流程）
ZEP_API_KEY=

# OpenAlex（学术论文 API；填邮箱进 polite pool 限流更松）
OPENALEX_EMAIL=

# Google OAuth（可选；缺失则只能用邮箱密码登录）
GOOGLE_CLIENT_ID=

# JWT 签名密钥（**生产必须改**）
JWT_SECRET=change-me-in-production

# ──────────────────────────────────────────────
# Auth bypass(DEV ONLY—生产绝对不能开)
# ──────────────────────────────────────────────
# True 时所有 auth + quota 检查被短路成 lowest-id 用户(dev 账户)。
# 用于本地测试免登录。生产环境必须设为 False 或删除该行。
# 启动时如果开关开了，主进程会打 70 字符包围的 WARNING。
AUTH_BYPASS_DEV_MODE=false

# ──────────────────────────────────────────────
# 邮件（可选；不配则邮箱验证 / 密码重置走 console 输出）
# ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5173

# ──────────────────────────────────────────────
# 支付(可选；不配则积分 / 订阅功能不可用)
# ──────────────────────────────────────────────

# Stripe(信用卡)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Crypto(USDT)
CRYPTO_WALLET_ADDRESS=
CRYPTO_WALLET_NETWORK=TRC-20
